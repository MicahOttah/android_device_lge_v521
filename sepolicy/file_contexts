# FRP partition
#
# system_server opens the FRP partition through
# /dev/block/bootdevice/by-name/persistent, but that is only a symlink;
# the kernel resolves it to the real node and SELinux labels the
# resolved path.  The by-name entry below therefore has no effect, the
# block device node itself has to carry the label.
#
# AOSP already contains
#   allow system_server frp_block_device:blk_file rw_file_perms;
#   neverallow system_server { dev_type -frp_block_device }:blk_file no_rw_file_perms;
# so with the correct label the FRP code works and no other block
# device becomes reachable from system_server.
/dev/block/mmcblk0p32                                                   u:object_r:frp_block_device:s0
/dev/block/bootdevice/by-name/persistent                            u:object_r:frp_block_device:s0

# Gestures
/sys/devices/virtual/input/lge_touch/lpwg_notify                    u:object_r:sysfs_gesture:s0

# Persist
/persist-lg(/.*)?                                                   u:object_r:persist_drm_file:s0

# Sensors
/sns                                                                u:object_r:sensors_data_file:s0
/sns/cal(/.*)?                                                      u:object_r:sensors_data_file:s0
/persist-lg/sensors(/.*)?                                           u:object_r:sensors_persist_file:s0

# IPA
#
# The CAF ipacm daemon writes its pid file into /data/misc/ipa.  CAF
# keeps the same directory in /data/vendor/ipa and labels it
# ipa_vendor_data_file (device/qcom/sepolicy/common/file_contexts:530),
# which is what the ipacm rules in
# device/qcom/sepolicy/common/ipacm.te:33-34 are written against.
#
# The directory must not keep the generic system_data_file label, because
# vendor domains may not write to system_data_file:
#   neverallow { domain -system_server -system_app -init -installd
#                -update_engine } system_data_file:file no_w_file_perms;
#
# init creates the directory ("mkdir /data/misc/ipa 0700 net_admin
# net_admin" in rootdir/etc/init.qcom.rc).  init's make_dir() looks the
# context up in file_contexts and calls setfscreatecon() before the
# mkdir(), so the label from this entry is applied to the new directory
# and the pid file inside it inherits it.
/data/misc/ipa(/.*)?                                                u:object_r:ipa_vendor_data_file:s0

# DPM
#
# /system/etc/dpm/dpm.conf holds the Fast Dormancy idle timers and the
# network masks; /system/etc/dpm/nsrm/NsrmConfiguration.xml holds the NSRM
# gate policy for the (missing) Java service.  The native daemon reads
# dpm.conf, so the directory and the files get their own type instead of
# the generic system_file label - see sepolicy/file.te and sepolicy/dpmd.te.
/system/etc/dpm(/.*)?                                               u:object_r:dpm_conf_file:s0

# Vendor daemons that live in /system/bin
#
# The CAF policy in device/qcom/sepolicy labels the vendor daemons with
# type_transition rules that expect the executables to live under
# /vendor/bin (file_contexts in device/qcom/sepolicy/common use the
# pattern "/(vendor|system/vendor)/bin/<daemon>").
#
# The v521 vendor blob list (vendor/lge/v521/v521-vendor.mk) however
# installs a handful of CAF blobs into /system/bin instead.  Without an
# explicit entry here those executables keep the generic system_file
# label, init finds no type_transition for them and every one of them
# ends up running inside the init domain (u:r:init:s0) instead of its
# own domain.  See notes/2026-11-16-selinux-daemon-domains.md.
#
/system/bin/adsprpcd                       u:object_r:adsprpcd_exec:s0
/system/bin/cnd                            u:object_r:cnd_exec:s0
/system/bin/cnss-daemon                    u:object_r:wcnss_service_exec:s0
/system/bin/ims_rtp_daemon                 u:object_r:hal_imsrtp_exec:s0
/system/bin/imsdatadaemon                  u:object_r:ims_exec:s0
/system/bin/imsqmidaemon                   u:object_r:ims_exec:s0
/system/bin/ipacm                          u:object_r:ipacm_exec:s0
/system/bin/ipacm-diag                     u:object_r:ipacm-diag_exec:s0
/system/bin/irsc_util                      u:object_r:irsc_util_exec:s0
/system/bin/mm-qcamera-daemon              u:object_r:mm-qcamerad_exec:s0
/system/bin/msm_irqbalance                 u:object_r:msm_irqbalanced_exec:s0
/system/bin/netmgrd                        u:object_r:netmgrd_exec:s0
/system/bin/pm-proxy                       u:object_r:per_mgr_exec:s0
/system/bin/pm-service                     u:object_r:per_mgr_exec:s0
/system/bin/qmuxd                          u:object_r:qmuxd_exec:s0
/system/bin/qseecomd                       u:object_r:tee_exec:s0
/system/bin/rmt_storage                    u:object_r:rmt_storage_exec:s0
/system/bin/sensors\.qcom                  u:object_r:sensors_exec:s0
/system/bin/tftp_server                    u:object_r:rfs_access_exec:s0
/system/bin/time_daemon                    u:object_r:time_daemon_exec:s0
/system/bin/wcnss_service                  u:object_r:wcnss_service_exec:s0
/system/bin/v521swap                       u:object_r:v521swap_exec:s0
