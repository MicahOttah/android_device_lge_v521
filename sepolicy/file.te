type sysfs_gesture, fs_type, sysfs_type;

# The remoteproc shared memory debugfs entry that rmt_storage writes to
# (debugfs_rmt) is NOT declared here: the Pie legacy CAF policy already
# declares it, together with the genfscon and the rules for the daemon:
#
#   device/qcom/sepolicy-legacy/legacy-common/file.te:1
#       type debugfs_rmt, debugfs_type, fs_type;
#   device/qcom/sepolicy-legacy/legacy-common/genfs_contexts:1
#       genfscon debugfs /rmt_storage u:object_r:debugfs_rmt:s0
#   device/qcom/sepolicy-legacy/legacy-common/rmt_storage.te:5-6
#       allow rmt_storage debugfs_rmt:dir search;
#       allow rmt_storage debugfs_rmt:file rw_file_perms;
#
# Declaring the type a second time would be a fatal "duplicate type"
# error in checkpolicy, and a second genfscon for the same filesystem and
# path is equally fatal.  sepolicy/daemons.te keeps a (narrower) copy of
# the rmt_storage rules for the record; duplicate allow rules are fine.
#
# AOSP forbids generic debugfs access:
#   neverallow { domain -init -system_server -dumpstate } debugfs:file no_rw_file_perms;
# (system/sepolicy/public/domain.te), which is why the entry needs a
# label of its own.

# The Qualcomm DPM configuration files below /system/etc/dpm.
#
# dpm.conf holds the Fast Dormancy idle timers and the network masks and
# is read by libdpmframework.so, which is linked into the dpmd daemon.
# The OEM policy of this device does not give dpmd any read access to
# system_file (it only has { execute execute_no_trans getattr } on it), so
# the config files need a label of their own for the daemon to be able to
# read them without giving it access to the whole of /system.
#
# See sepolicy/dpmd.te and notes/2026-11-16-dpm-nsrm.md.
type dpm_conf_file, file_type;

# The consumer infrared transmitter of the LGE SPI IR driver.
#
# The driver exposes two sysfs attributes (ir_data and ir_state) that
# the IR HAL has to read and write.  Giving them their own type keeps
# the access of the HAL limited to the IR interface; the generic sysfs
# type would hand it write access to every sysfs node of the device.
#
# See sepolicy/ir.te and sepolicy/genfs_contexts.
type sysfs_ir, fs_type, sysfs_type;

# vm.swappiness, written by init at boot and by the v521swap daemon
# (persist.v521.swap.swappiness).  Same pattern as the platform's
# proc_drop_caches / proc_overcommit_memory.  See sepolicy/swap.te.
type proc_swappiness, fs_type;
