# v521swap - the on-device swap manager (device/lge/v521/swap/v521swap.c).
#
# The tablet has 2 GB of RAM and no swap, which is what makes the low
# memory killer so aggressive.  This daemon turns swap on - a zram
# compressed-RAM area by default, optionally a real partition on the
# removable SD card - and keeps it reconciled with three
# persist.v521.swap.* properties.  See the "Swap" section of
# device/lge/v521/README.md.
type v521swap, domain;
type v521swap_exec, exec_type, file_type;
init_daemon_domain(v521swap)

# swapon(2) and swapoff(2) both need CAP_SYS_ADMIN.
allow v521swap self:capability sys_admin;

# The zram block device /dev/block/zram0 is labelled "ram_device" by the
# platform (system/sepolicy/private/file_contexts: /dev/block/zram[0-9]*).
# The daemon writes the legacy swap header to it (open/write) and then
# swaps it on (the kernel reads the header with the caller's creds).
allow v521swap ram_device:blk_file rw_file_perms;

# The zram control files /sys/block/zram0/{disksize,reset,max_comp_streams}
# live under /devices/virtual/block/zram0, already labelled "sysfs_zram"
# (system/sepolicy/public/file.te, .../private/genfs_contexts).
allow v521swap sysfs_zram:dir search;
allow v521swap sysfs_zram:file rw_file_perms;

# /proc/swaps, to reconcile against what is already active.  It is covered
# by the catch-all "genfscon proc / u:object_r:proc:s0".
allow v521swap proc:file r_file_perms;

# The uuid written into the swap header is read from /dev/urandom, which
# this policy labels random_device (shared with /dev/random).
allow v521swap random_device:chr_file r_file_perms;

# Read the configuration (persist.v521.swap.enabled / backend / size) and
# publish the result in v521.swap.status.  set_prop() grants both the
# property_service:set and the read of the property type.
set_prop(v521swap, v521_swap_prop)

# Both backends name their node under /dev/block, a directory of type
# block_device; looking a node up needs search on it.  This is the
# directory only - opening a block_device *node* stays forbidden
# (system/sepolicy/public/domain.te).
allow v521swap block_device:dir search;

# SD-card backend (backend = sdcard | both).
#
# The daemon reads the MBR from the whole-disk node /dev/block/mmcblk1
# (labelled sd_device by device/qcom/sepolicy) to find the type-0x82
# partition, then writes the swap header to that partition and swaps it on.
# The card is laid out by bin/sdcard-swap / bin/sdcard-rebuild with the
# swap partition as partition 2, which sepolicy/file_contexts labels
# swap_block_device - the platform type meant for swap areas.
allow v521swap sd_device:blk_file r_file_perms;
allow v521swap swap_block_device:blk_file rw_file_perms;
