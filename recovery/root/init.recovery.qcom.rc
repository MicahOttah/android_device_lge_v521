# Recovery-only init for the LG G Pad X 8.0 (V521).
#
# WHY THIS FILE EXISTS
#
# Android 8.x init (unlike 7.1) no longer creates the /dev/block/bootdevice
# symlink, and *every* partition path in /etc/recovery.fstab depends on it:
#
#     /dev/block/bootdevice/by-name/system
#     /dev/block/bootdevice/by-name/userdata
#     ...
#
# The ROM creates the symlink in rootdir/etc/init.target.rc ("on early-init"),
# but the recovery does NOT use that file:
#
#   * bootable/recovery/etc/init.rc only imports
#         import /init.recovery.${ro.hardware}.rc
#     and ro.hardware is "qcom" here (see BOARD_KERNEL_CMDLINE in
#     BoardConfig.mk), so the file must be named init.recovery.qcom.rc.
#
#   * build/make/core/Makefile (build-recoveryramdisk) removes every init*.rc
#     from the ramdisk and only re-adds init.rc and
#     $(TARGET_ROOT_OUT)/init.recovery.*.rc - the ROM's init.target.rc is not
#     among them.
#
# The result of the missing symlink was the failure of the previous LineageOS
# recovery: it came up with NO partitions mounted at all (/system, /data,
# /cache, ... all empty), which is what left the device in a semi-bricked
# state.  Do not remove this file without re-testing the mounts.
#
# HOW IT GETS INTO THE RAMDISK
#
# build/make/core/Makefile:
#     recovery_root_private := $(wildcard $(TARGET_DEVICE_DIR)/recovery/root)
#     ...
#     cp -rf $(recovery_root_private) $(TARGET_RECOVERY_OUT)/
#
# i.e. everything under device/lge/v521/recovery/root/ is copied verbatim into
# the root of the recovery ramdisk (this is the same mechanism the TWRP build
# uses via device/lge/v521/twrp/recovery/root/).  It is applied LAST, after the
# build strips init*.rc, so this file survives.
#
# This file is recovery-only; it is not part of the boot image.
#
# The bootdevice name comes from the kernel command line
# (androidboot.bootdevice=7824900.sdhci, see BOARD_KERNEL_CMDLINE), which
# init exposes as ro.boot.bootdevice.

on early-init
    # 8.1's adbd (system/core/adb/daemon/main.cpp, should_drop_privileges())
    # drops to AID_SHELL unless BOTH ro.debuggable=1 AND
    # "lineage.service.adb.root"=1 are set, which would leave us without a
    # root shell in the recovery.  The recovery's own init.rc reacts to that
    # property by restarting adbd as root.
    setprop lineage.service.adb.root 1

    # Do not use the recovery screensaver on this device.  It dims the
    # backlight after two minutes of inactivity and switches it off
    # completely after four minutes; a completely black screen in the
    # recovery looks like a dead device and the natural reaction to it is to
    # hold the power button, which reboots the device out of the recovery.
    # Read by RecoveryUI::InitScreensaver() in bootable/recovery/ui.cpp.
    setprop recovery.disable_screensaver 1

    # Best effort: /dev/block may not exist yet at this point (ueventd has
    # not been started), but symlink() happily creates a dangling symlink and
    # it starts resolving as soon as ueventd creates the target.
    symlink /dev/block/platform/soc.0/${ro.boot.bootdevice} /dev/block/bootdevice

on property:ro.debuggable=1
    setprop lineage.service.adb.root 1

on fs
    # ueventd has been running since early-init and has created the platform
    # device node; the "by-name" symlinks below it come from the same uevents.
    #
    # The timeout keeps a missing node from hanging the boot: init runs the
    # remaining commands of an action even when one of them fails, so the
    # symlink below is attempted either way (and a dangling symlink resolves
    # as soon as ueventd creates the target).
    wait /dev/block/platform/soc.0/${ro.boot.bootdevice} 30
    symlink /dev/block/platform/soc.0/${ro.boot.bootdevice} /dev/block/bootdevice

    setprop ro.board.platform msm8952

# NOTE: the TWRP variant of this file also starts an "sbinqseecomd" service
# (keymaster/keystore) when ro.crypto.state=encrypted.  That service is NOT
# declared here on purpose: /sbin/qseecomd does not exist in the AOSP recovery
# ramdisk (the binary only lives in /system/bin), so the service could never
# start.  This device reports ro.crypto.state=unencrypted, so the encrypted
# data partition is not a supported case for this recovery anyway.
