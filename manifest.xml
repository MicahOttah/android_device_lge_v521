<!--
    HIDL vendor manifest for the LG G Pad X 8.0 (V521), LineageOS 16.0
    (Android 9 Pie).

    Format: the Pie VINTF parser still accepts the <interface>/<name> +
    <instance> form that 15.1 used, so the structure is unchanged; the
    differences are in the HAL versions and the transports.

    Transports:
      * "hwbinder"  - a real service binary registers with hwservicemanager
                      (see hidl.mk, every -service package has to be listed
                      there as well).
      * "passthrough" with arch="32" - the client process loads the adapter
                      library itself through the HIDL passthrough loader
                      (system/libhidl/transport/ServiceManagement.cpp).  Only
                      the -impl library is needed; there is no service
                      process.

    The device is 32-bit only (TARGET_ARCH := arm), so a passthrough HAL is
    declared for "32" only: the client that loads the adapter is a 32-bit
    process.

    Changes against 15.1:
      * android.hardware.configstore is 1.1 in Pie, not 1.0.
      * android.hardware.soundtrigger was added: Pie's sound trigger service
        loads the adapter through the passthrough loader.
      * vendor.lineage.trust was added (LineageOS USB restriction).

    No fingerprint, no NFC, no thermal HAL module on this device; adds
    consumer IR.
-->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport arch="32">passthrough</transport>
        <version>2.0</version>
        <interface>
            <name>IDevicesFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio.effect</name>
        <transport arch="32">passthrough</transport>
        <version>2.0</version>
        <interface>
            <name>IEffectsFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.bluetooth</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IBluetoothHci</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.camera.provider</name>
        <transport arch="32">passthrough</transport>
        <version>2.4</version>
        <interface>
            <name>ICameraProvider</name>
            <instance>legacy/0</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.configstore</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>ISurfaceFlingerConfigs</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.drm</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>ICryptoFactory</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IDrmFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.gatekeeper</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IGatekeeper</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.gnss</name>
        <transport arch="32">passthrough</transport>
