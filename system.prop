#
# System.prop for LG G Pad X 8.0
#

# Audio
ro.qc.sdk.audio.ssr=false
audio.offload.buffer.size.kb=64
audio.offload.multiple.enabled=false
audio.offload.pcm.16bit.enable=true
audio.offload.pcm.24bit.enable=true
av.offload.enable=true
use.voice.path.for.pcm.voip=true

# Bluetooth
#bluetooth.hfp.client=1
qcom.bluetooth.soc=smd
ro.qualcomm.bt.hci_transport=smd

# Camera
camera.display.umax=1920x1080
camera.display.lmax=1280x720
camera.lowpower.record.enable=1
media.camera.ts.monotonic=0
vidc.enc.dcvs.extra-buff-count=2

# CNE
persist.cne.feature=1

# Data
ro.use_data_netmgrd=true
persist.data.netmgrd.qos.enable=true
persist.data.mode=concurrent

# DPM
# The Qualcomm DPM daemon (dpmd) is enabled with this bit mask.  The
# daemon reads it in DpmConfig::DpmConfig() (libdpmframework.so) and
# shuts down with "None of the dpm feature enabled, dpmd shutting down"
# when the mask is zero, so it has to be non-zero for dpmd to run at all.
#
#   bit 0 (1)  Fast Dormancy (FD)   - suspends the LTE/UMTS radio while
#                                     the screen is off and nothing is
#                                     moving.  Configured by
#                                     /system/etc/dpm/dpm.conf
#                                     (dpm_fd_enable_networks_mask).
#   bit 1 (2)  CTM (Connection Tracking Manager)
#   bit 2 (4)  NSRM (Network System Resource Manager)
#   bit 3 (8)  TCM (TCP Connection Manager)
#
# The Java side agrees: DpmApi.DPM_CONFIG_FEATURE_MASK_NSRM is 4,
# DpmApi.DPM_CONFIG_FEATURE_MASK_TCM is 8 and Dpm_ENABLE_PROPERTY_MASK
# is 15 (see com.qti.dpmapi.DpmApi in dpmapi.jar).
#
# NSRM (bit 2) is deliberately left out.  Its native half reads
# ro.serialno (libdpmnsrm.so), and AOSP protects that property:
#
#   neverallow { domain -adbd -dumpstate -hal_drm -hal_cas -init
#                -mediadrmserver -recovery -shell -system_server }
#       serialno_prop:file r_file_perms;
#
# (system/sepolicy/public/domain.te:451-465)
#
# Reading it would either need that neverallow lifted, which AOSP
# deliberately does not allow, or a hole in it.  NSRM's driver is missing
# anyway: neither dpmserviceapp.apk nor /vendor/bin/dpmQmiMgr exist in
# the stock LG ROM for this SoC, so the Java side of NSRM cannot run.
# See notes/2026-11-16-dpm-nsrm.md.
#
# 11 = FD (1) | CTM (2) | TCM (8)
persist.dpm.feature=11

# Display
ro.qualcomm.cabl=0
ro.sf.lcd_density=320

# Factory Reset Protection
ro.frp.pst=/dev/block/bootdevice/by-name/persistent

# Fingerprint
persist.qfp=false

# Fluence
ro.qc.sdk.audio.fluencetype=fluence
persist.audio.fluence.voicecall=true
persist.audio.fluence.voicerec=false
persist.audio.fluence.speaker=true

# GMS
# Device was launched with M
ro.product.first_api_level=23

# Graphics
persist.hwc.mdpcomp.enable=true

# OpenGLES
ro.opengles.version=196609

# Perf
ro.core_ctl_min_cpu=2
ro.core_ctl_max_cpu=4
ro.vendor.extension_library=libqti-perfd-client.so

# RIL
rild.libpath=/system/vendor/lib/libril-qc-qmi-1.so
rild.libargs=-d /dev/smd0
# The CAF RIL's verbose logging path is broken on this device: when it logs a
# SIM_IO request it walks off into a wild pointer and rild dies with
# SIGSEGV inside qcril_format_log_msg() -> vsnprintf() -> strlen().
#   backtrace: qcril_uim_request_sim_io -> qcril_format_log_msg -> vsnprintf
#              -> __vfprintf -> strlen
# The stock LG ROM leaves this logging off, so keep it off here as well.
persist.radio.adb_log_on=0
persist.radio.ril_log_enabled=0
persist.rild.nitz_plmn=
persist.rild.nitz_long_ons_0=
persist.rild.nitz_long_ons_1=
persist.rild.nitz_long_ons_2=
persist.rild.nitz_long_ons_3=
persist.rild.nitz_short_ons_0=
persist.rild.nitz_short_ons_1=
persist.rild.nitz_short_ons_2=
persist.rild.nitz_short_ons_3=
ril.subscription.types=NV,RUIM
DEVICE_PROVISIONED=1
ro.telephony.default_network=9
ro.telephony.ril_class=V521RIL

# Sensors
persist.debug.sensors.hal=e
debug.qualcomm.sns.daemon=e
debug.qualcomm.sns.libsensor1=e
persist.sensors.mag_filter_size=8
persist.sensors.knock_delay=1000
persist.sensors.sre_low_thresh=15000
persist.sensors.sre_high_thresh=25000
persist.sensors.mag_enabled=false

# Time services
persist.timed.enable=true

# Wi-Fi
wifi.interface=wlan0

# 15.1: multihal is built as sensors.$(TARGET_DEVICE); point the HAL loader at it
ro.hardware.sensors=v521

# Keep the recovery partition in step with the ROM: init starts
# install-recovery.sh (system/core init.rc) when this is true, so the
# recovery menu shows the installed build.  Settings has no switch for it
# in 15.1; "setprop persist.sys.recovery_update false" as root turns it off.
persist.sys.recovery_update=true
