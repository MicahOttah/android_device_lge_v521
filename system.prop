#
# System.prop for LG G Pad X 8.0
#

# Audio
ro.qc.sdk.audio.ssr=false
audio.offload.buffer.size.kb=64
audio.offload.multiple.enabled=false
audio.offload.pcm.16bit.enable=true
audio.offload.pcm.24bit.enable=true
av.offload.enable=true
use.voice.path.for.pcm.voip=true

# Bluetooth
#bluetooth.hfp.client=1
qcom.bluetooth.soc=smd
ro.qualcomm.bt.hci_transport=smd

# Camera
camera.display.umax=1920x1080
camera.display.lmax=1280x720
camera.lowpower.record.enable=1
media.camera.ts.monotonic=0
vidc.enc.dcvs.extra-buff-count=2

# CNE
persist.cne.feature=1

# Data
# NOTE: ro.use_data_netmgrd and persist.data.netmgrd.qos.enable are gone.
# Android 9 merged netmgrd into the platform netd (system/netd), and the
# CAF netmgrd blob is not installed any more - see
# device/lge/v521/sepolicy/daemons.te and v521-vendor.mk.
persist.data.mode=concurrent

# DPM
# The Qualcomm DPM daemon (dpmd) is installed (the native half only - the
# Java side has no driver on this device) but it is NOT started, so the
# persist.dpm.feature bit mask is not set here either: without the daemon
# it would only be a stale property.
#
# 15.1 shipped persist.dpm.feature=11 (FD | CTM | TCM).  In Android 9 the
# CAF netmgrd is gone (Pie merged the data connection into the platform
# netd), and Fast Dormancy installs its filter rules through the rmnet data
# socket that belonged to it - so the FD half lost its driver.  The service
# is disabled in rootdir/etc/init.qcom.rc; the blobs and their SELinux
# rules are still in the tree, so the feature can be switched back on.
# See notes/2026-11-16-dpm-nsrm.md.

# Display
ro.qualcomm.cabl=0
ro.sf.lcd_density=320

# Factory Reset Protection
ro.frp.pst=/dev/block/bootdevice/by-name/persistent

# Fingerprint
persist.qfp=false

# Fluence
ro.qc.sdk.audio.fluencetype=fluence
persist.audio.fluence.voicecall=true
persist.audio.fluence.voicerec=false
persist.audio.fluence.speaker=true

# GMS
# Device was launched with M
ro.product.first_api_level=23

# Graphics
persist.hwc.mdpcomp.enable=true

# OpenGLES
ro.opengles.version=196609

# Perf
ro.core_ctl_min_cpu=2
ro.core_ctl_max_cpu=4
ro.vendor.extension_library=libqti-perfd-client.so

# RIL
rild.libpath=/system/vendor/lib/libril-qc-qmi-1.so
rild.libargs=-d /dev/smd0
# The CAF RIL's verbose logging path is broken on this device: when it logs a
# SIM_IO request it walks off into a wild pointer and rild dies with
# SIGSEGV inside qcril_format_log_msg() -> vsnprintf() -> strlen().
#   backtrace: qcril_uim_request_sim_io -> qcril_format_log_msg -> vsnprintf
#              -> __vfprintf -> strlen
# The stock LG ROM leaves this logging off, so keep it off here as well.
persist.radio.adb_log_on=0
persist.radio.ril_log_enabled=0
persist.rild.nitz_plmn=
persist.rild.nitz_long_ons_0=
persist.rild.nitz_long_ons_1=
persist.rild.nitz_long_ons_2=
persist.rild.nitz_long_ons_3=
persist.rild.nitz_short_ons_0=
persist.rild.nitz_short_ons_1=
persist.rild.nitz_short_ons_2=
persist.rild.nitz_short_ons_3=
ril.subscription.types=NV,RUIM
DEVICE_PROVISIONED=1
ro.telephony.default_network=9
# ro.telephony.ril_class is gone.  Pie has no consumer for it (the property
# was only ever read by the pre-Pie RIL), no vendor blob reads the string,
# and ril/V521RIL.java was never compiled even in 15.1 - there is no
# ril/Android.mk and the class is absent from every jar in the 15.1 output.
# The file is kept as a record of the intended CAF request translation, but
# it is inert.  See BoardConfig.mk.

# Sensors
persist.debug.sensors.hal=e
debug.qualcomm.sns.daemon=e
debug.qualcomm.sns.libsensor1=e
persist.sensors.mag_filter_size=8
persist.sensors.knock_delay=1000
persist.sensors.sre_low_thresh=15000
persist.sensors.sre_high_thresh=25000
persist.sensors.mag_enabled=false

# Time services
persist.timed.enable=true

# Wi-Fi
wifi.interface=wlan0

# Sensors
# The multi-hal is built as sensors.$(TARGET_DEVICE); point the HAL loader at it
ro.hardware.sensors=v521

# Recovery
# The recovery partition holds TWRP and must keep holding it: the bring-up
# uses TWRP, not Lineage Recovery.
#
# init.rc (system/core/rootdir/init.rc) starts the flash_recovery service
# when persist.sys.recovery_update is true, and that service writes the
# Lineage recovery image over the TWRP in the recovery partition.  Pie does
# not ship install-recovery.sh any more, so the service cannot write
# anything - but the property is set to false anyway so that the intent is
# explicit and the service is never started.
#
# Note that the ROM zip does not contain a recovery image that gets flashed
# either; see notes/2026-11-18-pie-bringup.md.
persist.sys.recovery_update=false
